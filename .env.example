# Service Configuration
SERVICE_NAME=accelerator-provider
SERVICE_PORT=8003
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://admin:password@localhost:5434/accelerator_provider
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis (optional caching)
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300

# Control Plane Integration
CONTROL_PLANE_API_URL=http://localhost:8000
CONTROL_PLANE_AUTH_URL=https://auth.itlusions.com
CONTROL_PLANE_CLIENT_ID=accelerator-provider
CONTROL_PLANE_CLIENT_SECRET=

# DGX Platform Integration
DGX_PLATFORM_API_URL=http://localhost:9504
DGX_PLATFORM_API_KEY=

# OIDC / Auth
OIDC_REALM=itlusions
OIDC_CLIENT_ID=accelerator-provider
OIDC_CLIENT_SECRET=
